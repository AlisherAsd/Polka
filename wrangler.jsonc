// Конфиг Cloudflare Worker: Nuxt SSR + /api/** (Nitro-хендлеры) в одном деплое.
// Бэкенд Fastify из backend/ используется только для локальной разработки.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "polka",
  "main": "app/.output/server/index.mjs",
  "compatibility_date": "2025-07-15",
  // Nitro требует nodejs_als (AsyncLocalStorage); nodejs_compatv2 включает его и остальные node-API.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "app/.output/public",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "vars": {
    // Пусто — сайт обращается к API того же origin. Для внешних клиентов
    // (нативное приложение, отдельный хост) задай `https://api.<домен>`.
    "NUXT_PUBLIC_API_BASE": "",
    // Кому разрешено ходить в /api/** по CORS: сайт, dev и оболочки
    // (Tauri: tauri://localhost на macOS, http(s)://tauri.localhost на остальных).
    // Премиум: по умолчанию выключен; "true" включает корону, покупку и упоминания.
    "NUXT_PUBLIC_PREMIUM_ACTIVE": "false",
    "CORS_ORIGINS": "https://polka.alishersharipovtol.workers.dev,http://localhost:3000,http://localhost,https://localhost,capacitor://localhost,tauri://localhost,http://tauri.localhost,https://tauri.localhost",
  },
  // База карточек. database_id — заглушка: подставь id из `npx wrangler d1 create polka-db`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "polka-db",
      "database_id": "0be1f813-4297-452b-b297-1f220dcc45c6",
      "migrations_dir": "app/migrations",
    },
  ],
}
