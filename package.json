{
  "name": "polka",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "XDG_CONFIG_HOME=$PWD/.wrangler/config/xdg npm --workspace polka-frontend run dev",
    "build": "npm --workspace polka-frontend run build",
    "deploy": "wrangler deploy",
    "typecheck": "npm --workspace polka-frontend run typecheck",
    "d1:migrate": "wrangler d1 migrations apply polka-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply polka-db --remote",
    "desktop:web": "NUXT_SPA=1 NUXT_PUBLIC_API_BASE=${NUXT_PUBLIC_API_BASE:-https://polka.alishersharipovtol.workers.dev} npm --workspace polka-frontend run generate",
    "desktop:build": "npm run desktop:web && npm --prefix apps/desktop run build"
  },
  "devDependencies": {
    "wrangler": "^4.158.0"
  },
  "workspaces": [
    "app"
  ]
}
