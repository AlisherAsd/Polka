{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Полка",
  "version": "1.0.0",
  "identifier": "app.polka.desktop",
  "build": {
    "frontendDist": "../../../app/.output/public",
    "beforeDevCommand": "npm --prefix ../.. run dev",
    "beforeBuildCommand": "npm --prefix ../.. run desktop:web",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "Полка",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "category": "Productivity",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
