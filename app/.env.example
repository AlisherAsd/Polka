# Локальные переменные приложения (Nitro читает их в `npm run dev`).
# Скопируйте в `.env` — файл в .gitignore.

# Ключ OpenRouter для локальной разработки ИИ-функций.
# В проде это секрет воркера: `npx wrangler secret put OPENROUTER_KEY`.
OPENROUTER_KEY=

# База API. Пусто (по умолчанию) — тот же origin: локальный dev вызывает
# Nitro-ручки на localhost:3000, веб в проде — тот же воркер.
# Заполняется только для статики (нативное приложение): см. `npm run desktop:web`.
NUXT_PUBLIC_API_BASE=
